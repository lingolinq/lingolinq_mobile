<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android 12 Auto Backup. Local boards, pictures, sounds, and preferences stay on the device. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <!-- WebView localStorage and IndexedDB (session token, usage log). getDir() is the root domain. -->
    <exclude domain="root" path="app_webview/" />
</full-backup-content>
