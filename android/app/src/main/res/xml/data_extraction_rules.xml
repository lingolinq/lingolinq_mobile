<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later. Exclude the same domains from cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <!-- WebView localStorage and IndexedDB (session token, usage log). getDir() is the root domain. -->
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
