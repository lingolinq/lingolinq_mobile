{
  "name": "lingolinq_mobile",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "package": "./bin/package_from_lingolinq",
    "package:local": "LINGOLINQ_API_HOST=http://localhost:5000 PACKAGE_SOURCE=prod ./bin/package_from_lingolinq",
    "sync:android": "npm run package && npx cap sync android",
    "sync:android:local": "npm run package:local && npx cap sync android",
    "sync:ios": "npm run package && npx cap sync ios",
    "sync:ios:local": "npm run package:local && npx cap sync ios",
    "open:android": "npx cap open android",
    "run:android": "npx cap run android",
    "test": "node --test test/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "description": "LingoLinq Capacitor 8 native shell (Android/iOS)",
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/device": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "private": true,
  "devDependencies": {
    "@capacitor/cli": "^8.5.3"
  }
}
