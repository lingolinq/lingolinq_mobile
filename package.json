{
  "name": "lingolinq_mobile",
  "version": "0.1.0",
  "main": "index.js",
  "scripts": {
    "package": "./bin/package_from_lingolinq",
    "package:local": "LINGOLINQ_API_HOST=http://localhost:5000 PACKAGE_SOURCE=prod ./bin/package_from_lingolinq",
    "sync:android": "npm run package && npx cap sync android",
    "sync:android:local": "npm run package:local && npx cap sync android",
    "sync:ios": "npm run package && npx cap sync ios",
    "sync:ios:local": "npm run package:local && npx cap sync ios",
    "open:android": "npx cap open android",
    "run:android": "npx cap run android"
  },
  "keywords": [],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "description": "LingoLinq Capacitor 7 native shell (Android/iOS)",
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor-community/text-to-speech": "^6.1.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/cli": "^7.6.8",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.6.8",
    "@capacitor/device": "^7.0.5",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/ios": "^7.6.8",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/network": "^7.0.4",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6"
  },
  "private": true
}
